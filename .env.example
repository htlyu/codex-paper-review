# Required: random token of at least 24 characters; not an OpenAI API key.
REVIEW_API_TOKEN=

# The API runs on the host; these paths are host paths.
REVIEW_DATA_DIR=./var
REVIEW_AUTH_FILE=~/.codex/auth.json
REVIEW_DOCKER_IMAGE=paper-review-worker:local
REVIEW_DOCKER_BIN=docker
# Optional existing host proxy, reachable inside Docker. Leave blank for direct access.
# Example: http://host.docker.internal:7897
REVIEW_PROXY_URL=

REVIEW_MODEL=gpt-6-astra
REVIEW_REASONING=xhigh
# Legacy setting; the staged workflow disables nested subagents.
REVIEW_MAX_SUBAGENTS=6
REVIEW_TIMEOUT_SECONDS=3600

# 20 MiB, 100 pages, and at most 20 pending jobs.
REVIEW_MAX_UPLOAD_BYTES=20971520
REVIEW_MAX_PAGES=100
REVIEW_MAX_PENDING_JOBS=20
